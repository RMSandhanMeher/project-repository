<?xml version="1.0" encoding="UTF-8"?>
<faces-config xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee 
              http://java.sun.com/xml/ns/javaee/web-facesconfig_2_0.xsd"
	version="2.0" metadata-complete="false">

	<!-- ✅ MODEL BEANS (Provider) -->
	<managed-bean>
		<managed-bean-name>appointment</managed-bean-name>
		<managed-bean-class>com.infinite.jsf.provider.model.Appointment</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>doctor</managed-bean-name>
		<managed-bean-class>com.infinite.jsf.provider.model.Doctors</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>provider</managed-bean-name>
		<managed-bean-class>com.infinite.jsf.provider.model.Provider</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>medicalProcedure</managed-bean-name>
		<managed-bean-class>com.infinite.jsf.provider.model.MedicalProcedure</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>prescription</managed-bean-name>
		<managed-bean-class>com.infinite.jsf.provider.model.Prescription</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>procedureTest</managed-bean-name>
		<managed-bean-class>com.infinite.jsf.provider.model.ProcedureTest</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ✅ MODEL BEANS (Recipient) -->
	<managed-bean>
		<managed-bean-name>recipient</managed-bean-name>
		<managed-bean-class>com.infinite.jsf.recipient.model.Recipient</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>authBean</managed-bean-name>
		<managed-bean-class>com.infinite.jsf.recipient.controller.RecipientShowInsuranceController</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>


	<!-- ✅ DAO BEANS -->
	<managed-bean>
		<managed-bean-name>insuranceDaoImpl</managed-bean-name>
		<managed-bean-class>com.infinite.jsf.recipient.daoImpl.InsuranceDaoImpl</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>loginDao</managed-bean-name>
		<managed-bean-class>com.infinite.jsf.recipient.daoImpl.LoginDaoImpl</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ✅ CONTROLLERS -->
	<managed-bean>
		<managed-bean-name>showincController</managed-bean-name>
		<managed-bean-class>com.infinite.jsf.recipient.controller.RecipientShowInsuranceController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>

		<managed-property>
			<property-name>medicalProcedure</property-name>
			<property-class>com.infinite.jsf.provider.model.MedicalProcedure</property-class>
			<value>#{medicalProcedure}</value>
		</managed-property>

		<managed-property>
			<property-name>insuranceDaoImpl</property-name>
			<property-class>com.infinite.jsf.recipient.daoImpl.InsuranceDaoImpl</property-class>
			<value>#{insuranceDaoImpl}</value>
		</managed-property>

		<managed-property>
			<property-name>recipient</property-name>
			<property-class>com.infinite.jsf.recipient.model.Recipient</property-class>
			<value>#{recipient}</value>
		</managed-property>
	</managed-bean>

<managed-bean>
		<managed-bean-name>loginController</managed-bean-name>
		<managed-bean-class>com.infinite.jsf.recipient.controller.RecipientLoginController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
 
		<managed-property>
			<property-name>loginDao</property-name>
			<property-class>com.infinite.jsf.recipient.daoImpl.LoginDaoImpl</property-class>
			<value>#{loginDao}</value>
		</managed-property>
 
		<managed-property>
			<property-name>recipient</property-name>
			<property-class>com.infinite.jsf.recipient.model.Recipient</property-class>
			<value>#{recipient}</value>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>doctorSearchController</managed-bean-name>
		<managed-bean-class>com.infinite.jsf.recipient.controller.RecipientSearchDoctorController</managed-bean-class>
		<managed-bean-scope>view</managed-bean-scope>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>recipientAppointmentController</managed-bean-name>
		<managed-bean-class>com.infinite.jsf.provider.controller.RecipientAppointmentController</managed-bean-class>
		<managed-bean-scope>view</managed-bean-scope>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>doctorAvailabilityController</managed-bean-name>
		<managed-bean-class>com.infinite.jsf.provider.controller.DoctorAvailabilityController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>appointmentDetailController</managed-bean-name>
		<managed-bean-class>com.infinite.jsf.provider.controller.AppointmentDetailController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	<!-- navigation rule -->
	
	<navigation-rule>
		<from-view-id>/recipient/SearchProviders.jsf</from-view-id>
		<navigation-case>
			<from-outcome>doctorAvailabilityList</from-outcome>
			<to-view-id>/recipient/appointment/doctorAvailabilityList.jsf</to-view-id>
			<redirect /> <!-- Use redirect to ensure clean URL and prevent double submit -->
		</navigation-case>
	</navigation-rule>
	
  <managed-bean>
	<managed-bean-name>recipientNavigationHelper</managed-bean-name>
	<managed-bean-class>com.infinite.jsf.recipient.filter.RecipientNavigationHelper</managed-bean-class>
	<managed-bean-scope>session</managed-bean-scope>
  </managed-bean>
	
</faces-config>